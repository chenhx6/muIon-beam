{
  "schema_version": 2,
  "gitee": {
    "max_file_bytes": 10485760,
    "max_task_bytes": 52428800,
    "allow_prefixes": [
      ".codex/skills/",
      "00_project/",
      "01_physics/",
      "04_results/",
      "05_reports/",
      "06_external_lib/",
      "90_migration/",
      "tests/",
      "07_research_system/",
      "08_references/",
      "09_catalog/",
      "10_plans/",
      "11_tools/",
      "AGENTS.md",
      "README.md",
      "REPRODUCIBILITY.md",
      "package.json",
      ".gitignore",
      ".codex/hooks.json"
    ],
    "deny_prefixes": [
      ".git/",
      "_work/",
      "00_project/state/3d-smoke/",
      "00_project/traceability/sync-outbox/",
      "02_models/",
      "03_runs/formal/"
    ],
    "deny_extensions": [
      ".mph",
      ".sldasm",
      ".sldprt",
      ".slddrw",
      ".step",
      ".stp",
      ".x_t",
      ".vtk",
      ".h5",
      ".hdf5",
      ".root",
      ".bin",
      ".pyd",
      ".dll",
      ".exe",
      ".pyc",
      ".msi",
      ".zip",
      ".7z",
      ".obj",
      ".o",
      ".class",
      ".sqlite"
    ],
    "model_sources": {
      "prefix": "02_models/",
      "extensions": [
        ".py",
        ".mjs",
        ".js",
        ".ts",
        ".c",
        ".cc",
        ".cpp",
        ".cxx",
        ".h",
        ".hh",
        ".hpp",
        ".hxx",
        ".java",
        ".cs",
        ".cmake",
        ".mac",
        ".gdml",
        ".yaml",
        ".yml",
        ".json",
        ".toml",
        ".xml",
        ".ini",
        ".cfg",
        ".csv",
        ".tsv",
        ".txt",
        ".md",
        ".sh",
        ".ps1",
        ".bat",
        ".m"
      ],
      "filenames": [
        "makefile",
        "dockerfile"
      ],
      "excluded_directory_names": [
        "build",
        "cmakefiles",
        "output",
        "outputs",
        "results",
        "raw",
        "logs",
        "cache",
        "__pycache__",
        "node_modules",
        "dist"
      ]
    },
    "limits_basis": "Project byte budgets, not asserted provider quotas. Repository history and account quota require separate capacity checks before a bulk source publication."
  }
}
