{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "muion-beam/figure-manifest.schema.json",
  "type": "object",
  "required": ["schema_version", "figures"],
  "properties": {
    "schema_version": {"type": "string"},
    "figures": {"type": "array", "items": {"$ref": "#/$defs/figure"}}
  },
  "$defs": {
    "figure": {
      "type": "object",
      "required": ["figure_id", "run_id", "figure_class", "source_code", "input_snapshot", "backend", "outputs", "qa"],
      "properties": {
        "figure_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "figure_class": {"enum": ["diagnostic", "analysis", "final"]},
        "source_code": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}},
        "input_snapshot": {"type": "object", "required": ["run_manifest", "source_data"], "properties": {"run_manifest": {"type": "string"}, "source_data": {"type": "array"}}},
        "backend": {"enum": ["python", "r", "comsol", "solidworks", "geant4"]},
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}}},
        "qa": {"type": "object", "required": ["status", "report"], "properties": {"status": {"enum": ["pass", "warn", "fail"]}, "report": {"type": "string"}}},
        "semantic_note": {"type": ["string", "null"]},
        "checkpoint_id": {"type": ["string", "null"]},
        "figure_type": {"type": "string"},
        "retention_level": {"type": "string"}
      }
    }
  }
}
