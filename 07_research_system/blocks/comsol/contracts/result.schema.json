{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "muion-beam/comsol-result.schema.json",
  "type": "object",
  "required": ["schema_version", "result_id", "task_id", "status", "adapter", "build", "baseline", "cases", "validation", "findings", "warnings", "issues", "escalations", "scope_expansion_requests", "assumptions", "exploration_history", "stopping_reason", "next_interface_requests", "execution_record"],
  "properties": {
    "schema_version": {"type": "string"},
    "result_id": {"type": "string"},
    "task_id": {"type": "string"},
    "status": {"enum": ["complete", "partial", "failed", "blocked"]},
    "adapter": {"type": "object"},
    "build": {"type": "object"},
    "baseline": {"type": "object"},
    "cases": {"type": "array"},
    "validation": {"type": "object"},
    "findings": {"type": "array"},
    "warnings": {"type": "array"},
    "issues": {"type": "array"},
    "escalations": {"type": "array"},
    "scope_expansion_requests": {"type": "array"},
    "assumptions": {"type": "array"},
    "exploration_history": {"type": "array"},
    "stopping_reason": {"type": "string"},
    "next_interface_requests": {"type": "array"},
    "execution_record": {"type": "object"}
  },
  "additionalProperties": true
}

